<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MPL-2.0. Contents/MacOS/security-module-helper.app (Firefox ships it on nightly only;
  applied only if present). Mirrors pinned Firefox 156.0
  security/mac/hardenedruntime/production/security-module-helper.xml.
-->
<plist version="1.0">
  <dict>
    <!-- Allow loading third party pkcs11 libraries -->
    <key>com.apple.security.cs.disable-library-validation</key><true/>
    <!-- SmartCardServices(7) -->
    <key>com.apple.security.smartcard</key><true/>
  </dict>
</plist>
