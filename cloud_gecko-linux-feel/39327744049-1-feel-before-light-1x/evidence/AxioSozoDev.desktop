[Desktop Entry]
Version=1.5
Type=Application
Name=AxioSozo Dev
GenericName=Web Browser
Comment=Browse the web with AxioSozo (development build)
Exec=/home/runner/axiosozo-build/linux-app/39319467610/axiosozo-dev/axiosozo-dev %u
Icon=axiosozo-dev
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/vnd.mozilla.xul+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=AxioSozoDev
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=/home/runner/axiosozo-build/linux-app/39319467610/axiosozo-dev/axiosozo-dev --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=/home/runner/axiosozo-build/linux-app/39319467610/axiosozo-dev/axiosozo-dev --private-window %u
