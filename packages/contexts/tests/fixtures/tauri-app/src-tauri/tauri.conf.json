{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Fixture",
  "version": "0.1.0",
  "identifier": "com.example.tauri-fixture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": { "windows": [{ "title": "Tauri Fixture", "width": 800, "height": 600 }] },
  "plugins": {
    "updater": { "endpoints": ["https://github.com/acme/tauri-app/releases/latest/download/latest.json"] }
  }
}
