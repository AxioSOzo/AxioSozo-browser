{
  "version": 1,
  "name": "compose-fly",
  "kind": "web",
  "kind_source": {
    "source": "fly.toml",
    "guess": false
  },
  "environments": [
    {
      "name": "production",
      "base_url": "https://compose-demo.fly.dev/",
      "source": "fly.toml app (fly.dev default domain)",
      "guess": true
    }
  ],
  "services": [
    {
      "name": "web",
      "url": "http://localhost:8080/",
      "port": 8080,
      "source": "docker-compose.yml services.web.ports",
      "guess": false
    },
    {
      "name": "api",
      "url": "http://localhost:3000/",
      "port": 3000,
      "source": "docker-compose.yml services.api.ports",
      "guess": false
    },
    {
      "name": "db",
      "url": "http://localhost:5432/",
      "port": 5432,
      "source": "docker-compose.yml services.db.ports",
      "guess": false
    },
    {
      "name": "metrics",
      "url": "http://localhost:9090/",
      "port": 9090,
      "source": "docker-compose.yml services.metrics.ports",
      "guess": true
    }
  ],
  "surfaces": [
    {
      "name": "Fly.io (compose-demo)",
      "url": "https://fly.io/apps/compose-demo",
      "kind": "hosting",
      "prominence": "secondary",
      "source": "fly.toml app",
      "guess": false
    }
  ],
  "frameworks": [],
  "files_read": [
    "fly.toml",
    "docker-compose.yml"
  ],
  "refused": [],
  "warnings": [
    "docker-compose.yml: services.dns port udp, ignored",
    "docker-compose.yml: services.lan port bound to a non-loopback address, ignored"
  ]
}
